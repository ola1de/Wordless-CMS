# WORDLESS — example environment variables.
# Copy to `.env` and fill in ONLY the values you need. `.env` is git-ignored;
# this file is safe to commit because every value here is a placeholder.
# Never put real secrets in this file, in code, or in chat.

# --- Cloudflare (production only; NOT needed for local development) -------
# Your Cloudflare account ID. Only required when deploying with Wrangler
# outside the `wrangler login` OAuth flow. Find it in the Cloudflare
# dashboard (right sidebar). Leave blank when using `wrangler login`.
CLOUDFLARE_ACCOUNT_ID=

# Optional: override the D1 database / R2 bucket / KV namespace ids after
# provisioning. The installer writes the real ids into wrangler.toml for
# you; these variables are only a fallback for CI-style setups.
# WORDLESS_D1_ID=
# WORDLESS_R2_BUCKET=wordless-media
# WORDLESS_KV_CONFIG_ID=

# --- AI providers (later milestones — not used in Milestone 1) -------------
# Wordless will support multiple providers; no single vendor is required.
# Add a key only for the provider(s) you actually configure.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GEMINI_API_KEY=

# --- Email (later milestones — not used in Milestone 1) --------------------
# RESEND_API_KEY=
# BREVO_API_KEY=
# SENDGRID_API_KEY=

# --- Payments (later milestones — not used in Milestone 1) -----------------
# STRIPE_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
