{
  "description": "WORDLESS — autonomous website operating system. PHP-independent, WordPress-compatible CMS on Cloudflare Workers (TypeScript). Milestone 1: foundations.",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  },
  "name": "wordless",
  "private": true,
  "scripts": {
    "build": "npm run build:admin && tsc --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "build:admin": "vite build -c admin/vite.config.ts",
    "dev": "wrangler dev",
    "predev": "npm run build:admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "setup": "node scripts/install.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "type": "module",
  "version": "0.1.0"
}
